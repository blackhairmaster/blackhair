# ---------------------------------------------------------------
# Contact form (serverless endpoint: /api/contact)
# Copy this file to `.env` and fill in the values.
# NEVER commit the real `.env` — it must stay server-side only.
# ---------------------------------------------------------------

# Where the messages should be delivered
CONTACT_EMAIL=

# API key from https://resend.com  (starts with "re_")
RESEND_API_KEY=

# Optional: who the email is sent from (must be a verified domain on Resend)
# CONTACT_FROM=
